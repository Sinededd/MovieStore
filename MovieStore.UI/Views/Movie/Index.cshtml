@model ListModel<Movie>

@{
    ViewData["Title"] = "Афиша кинотеатра";
    var genres = ViewData["Genres"] as IEnumerable<Genre> ?? Enumerable.Empty<Genre>();
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();
    var genre = request.Query["genre"].ToString();
    var previousPage = Model.CurrentPage == 1 ? 1 : Model.CurrentPage - 1;
    var nextPage = Model.CurrentPage == Model.TotalPages ? Model.TotalPages : Model.CurrentPage + 1;
}

@if (TempData["CartMessage"] is string cartMessage)
{
    <div class="alert alert-success" role="alert">@cartMessage</div>
}

<div class="row align-items-center mb-3">
    <div class="col"><h1 class="mb-0">Афиша кинотеатра</h1></div>
    <div class="col-auto">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                @ViewData["CurrentGenre"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Movie" asp-action="Index">Все жанры</a></li>
                @foreach (var item in genres)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Movie" asp-action="Index"
                           asp-route-genre="@item.NormalizedName">@item.Name</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(item.Image ?? "/images/films/noimage.svg")" class="card-img-top catalog-image" alt="Постер фильма @item.Name" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="text-muted mt-auto mb-3">Билет: @item.Price.ToString("0.00") руб.</p>
                    <a class="btn btn-primary" asp-controller="Cart" asp-action="Add"
                       asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">
                        Купить билет <i class="bi bi-ticket-perforated"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<nav class="mt-4" aria-label="Переключение страниц афиши кинотеатра">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : string.Empty)">
            <a class="page-link" asp-route-genre="@genre" asp-route-pageNo="@previousPage">Назад</a>
        </li>
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                <a class="page-link" asp-route-genre="@genre" asp-route-pageNo="@pageNumber">@pageNumber</a>
            </li>
        }
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)">
            <a class="page-link" asp-route-genre="@genre" asp-route-pageNo="@nextPage">Вперёд</a>
        </li>
    </ul>
</nav>
