@model Microsoft.AspNetCore.Mvc.Rendering.SelectList

<h2>@ViewData["Title"]</h2>

@if (ViewData["FormMessage"] is string formMessage)
{
    <div class="alert alert-success" role="alert">@formMessage</div>
}

<h3>Список</h3>
<ol type="A">
    @for (var number = 1; number <= 4; number++)
    {
        <li>элемент @number списка</li>
    }
</ol>

<h3 class="mt-4">Форма</h3>
<form asp-controller="Home" asp-action="Index" method="post">
    <div class="row mb-3">
        <label for="listDemo" class="col-sm-2 col-form-label">Список:</label>
        <div class="col-sm-10">
            <select id="listDemo" name="listDemo" class="form-select" asp-items="Model"></select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-10 offset-sm-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="chk1" name="chk1">
                <label class="form-check-label" for="chk1">Чек-бокс 1</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="chk2" name="chk2">
                <label class="form-check-label" for="chk2">Чек-бокс 2</label>
            </div>
        </div>
    </div>

    <fieldset class="row mb-3">
        <div class="col-sm-10 offset-sm-2">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="radioGroup" id="radio1" value="1" checked>
                <label class="form-check-label" for="radio1">Радио-1</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="radioGroup" id="radio2" value="2">
                <label class="form-check-label" for="radio2">Радио-2</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="radioGroup" id="radio3" value="3">
                <label class="form-check-label" for="radio3">Радио-3</label>
            </div>
        </div>
    </fieldset>

    <div class="row mb-3">
        <label for="inputLogin" class="col-sm-2 col-form-label">Логин:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputLogin" name="login" placeholder="Введите имя">
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputPassword" class="col-sm-2 col-form-label">Пароль:</label>
        <div class="col-sm-10">
            <input type="password" class="form-control" id="inputPassword" name="password" placeholder="Введите пароль">
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-10 offset-sm-2">
            <button type="submit" class="btn btn-primary">Отправить</button>
        </div>
    </div>
</form>
