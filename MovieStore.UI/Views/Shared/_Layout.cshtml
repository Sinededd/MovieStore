<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <div class="container">
            <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom border-body" data-bs-theme="dark">
                <partial name="_MenuPartial" />
                <partial name="_UserInfoPartial" />
            </nav>
        </div>
    </header>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="navbar navbar-expand-md navbar-dark bg-dark">
                <div class="navbar-nav ms-auto flex-row">
                    <a class="nav-item nav-link px-2" href="https://www.facebook.com" target="_blank" rel="noopener">
                        <i class="bi bi-facebook" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link px-2" href="https://www.x.com" target="_blank" rel="noopener">
                        <i class="bi bi-twitter-x" style="font-size: 2rem"></i>
                    </a>
                    <a class="nav-item nav-link px-2" href="https://telegram.org" target="_blank" rel="noopener">
                        <i class="bi bi-telegram" style="font-size: 2rem"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
