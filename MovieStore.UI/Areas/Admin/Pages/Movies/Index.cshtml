@page
@model MovieStore.UI.Areas.Admin.Pages.Movies.IndexModel
@{
    ViewData["Title"] = "Управление фильмами";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Фильмы</h1>
    <a class="btn btn-primary" asp-page="./Create"><i class="bi bi-plus-lg"></i> Добавить фильм</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Постер</th><th>Название</th><th>Жанр</th><th>Цена</th><th>Действия</th></tr></thead>
            <tbody>
            @foreach (var movie in Model.Movies.Items)
            {
                <tr>
                    <td><img src="@movie.Image" alt="Постер @movie.Name" width="64" height="88" style="object-fit: cover" /></td>
                    <td>@movie.Name</td>
                    <td>@movie.Genre?.Name</td>
                    <td>@movie.Price.ToString("0.00") руб.</td>
                    <td>
                        <a class="btn btn-outline-info btn-sm" asp-page="./Details" asp-route-id="@movie.Id" title="Подробности"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-outline-primary btn-sm" asp-page="./Edit" asp-route-id="@movie.Id" title="Изменить"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-outline-danger btn-sm" asp-page="./Delete" asp-route-id="@movie.Id" title="Удалить"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <nav aria-label="Страницы списка фильмов">
        <ul class="pagination">
            @for (var number = 1; number <= Model.Movies.TotalPages; number++)
            {
                <li class="page-item @(number == Model.Movies.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pageNo="@number">@number</a>
                </li>
            }
        </ul>
    </nav>
}
