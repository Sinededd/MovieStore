@page "{id:int}"
@model MovieStore.UI.Areas.Admin.Pages.Movies.DetailsModel
@{
    ViewData["Title"] = "Информация о фильме";
}

<h1>@Model.Movie.Name</h1>
<img src="@Model.Movie.Image" alt="Постер @Model.Movie.Name" width="180" class="mb-3" />
<p>@Model.Movie.Description</p>
<p><strong>Жанр:</strong> @Model.Movie.Genre?.Name</p>
<p><strong>Цена:</strong> @Model.Movie.Price.ToString("0.00") руб.</p>
<a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Movie.Id">Редактировать</a>
<a class="btn btn-secondary" asp-page="./Index">Назад</a>
